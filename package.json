{
  "name": "discord-music-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "register:commands": "tsx -r dotenv/config src/core/CommandRegistry.ts register"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/rest": "^2.4.0",
    "@discordjs/voice": "0.17.0",
    "@distube/ytdl-core": "^4.16.12",
    "discord-api-types": "^0.37.83",
    "discord.js": "14.22.1",
    "dotenv": "16.6.1",
    "libsodium-wrappers": "^0.7.15",
    "opusscript": "0.0.8",
    "play-dl": "1.9.7",
    "prism-media": "1.3.5",
    "spotify-web-api-node": "^5.0.2",
    "undici": "^6.21.3",
    "youtubei.js": "^15.0.1",
    "yt-search": "^2.13.1",
    "ytpl": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/spotify-web-api-node": "^5.0.11",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
